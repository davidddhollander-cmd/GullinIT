config_version=5

[application]
config/name="Gullin' It"
run/main_scene="res://scenes/loading.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
boot_splash/bg_color=Color(0.663, 0.843, 0.824, 1)
boot_splash/stretch_mode=4
boot_splash/use_filter=true
boot_splash/image="res://assets/sprites/loading-backdrop-v2.png"

[autoload]
Config="*res://scripts/autoload/config.gd"
GameState="*res://scripts/autoload/game_state.gd"
Audio="*res://scripts/autoload/audio.gd"
MCPBridge="*res://addons/godot_mcp/mcp_bridge.gd"

[display]
window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input_devices]
pointing/emulate_mouse_from_touch=false

[rendering]
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12, 0.2, 0.26, 1)
2d/snap/snap_2d_transforms_to_pixel=true
